# Copy to .env.local. Without these the app runs with sign-in switched off,
# which only works against an API started with EQUITI_AUTH=off (local only).
# Values come from Firebase console → Project settings → Your apps → Web app.
# They identify the project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
